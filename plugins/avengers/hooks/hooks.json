{
  "description": "PostToolUse: truncates oversized Bash stdout/stderr (head+tail, ~8,000 chars); AVENGERS_TRUNCATE=off disables, AVENGERS_TRUNCATE_CHARS overrides the budget. UserPromptSubmit: names up to 3 relevant skills (AVENGERS_SKILL_HINT=off disables) and vault notes (AVENGERS_MEMORY=off disables) next to the prompt. SessionStart: offers a one-time memory migration for repos with past runs. All fail open on any error.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/memory.js", "hook-session"],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/skills.js", "hook"],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/memory.js", "hook-prompt"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/truncate-tool-output.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
